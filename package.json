{
  "name": "@bibash007/nepali-calendar",
  "version": "1.0.2",
  "description": "Bikram Sambat (BS) calendar logic and React hooks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist --rootDir . --skipLibCheck",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nepali",
    "bikram-sambat",
    "bs",
    "calendar",
    "react",
    "date-converter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/you/nepali-calendar"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.7"
  }
}
